# Server Configuration
PORT=5000
NODE_ENV=production
JWT_SECRET=smartspend_secret_jwt_key_2026_super_secure

# ========================================================
# Real-Time Email OTP Delivery Configuration (Nodemailer)
# ========================================================

# OPTION A: Gmail (Quickest & Free)
# 1. Enable 2-Step Verification in your Google Account
# 2. Go to: https://myaccount.google.com/apppasswords
# 3. Create an App Password for "Mail" (gives you a 16-letter code like "abcd efgh ijkl mnop")
SMTP_SERVICE=gmail
SMTP_USER=youremail@gmail.com
SMTP_PASS=abcdefghijklmnop
SMTP_FROM="SmartSpend AI" <youremail@gmail.com>

# OPTION B: Professional Custom SMTP (Brevo, SendGrid, Resend, Amazon SES, Mailgun)
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USER=your_smtp_user
# SMTP_PASS=your_smtp_key
# SMTP_FROM="SmartSpend AI" <verify@yourdomain.com>

# ========================================================
# Google Gemini API Key (Optional)
# ========================================================
# If omitted, SmartSpend uses its high-speed built-in financial intelligence engine.
# Users can also input their own API key dynamically in the Settings tab.
GEMINI_API_KEY=
